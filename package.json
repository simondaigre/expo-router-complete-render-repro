{
  "name": "expo-router-complete-render-repro",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-server": "~58.0.6",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export": "expo export --platform web",
    "serve": "expo serve",
    "fix": "patch -p1 -N -d node_modules/@expo/router-server < fix/router-server.patch && patch -p1 -N -d node_modules/expo-router < fix/expo-router.patch",
    "unfix": "patch -p1 -R -d node_modules/@expo/router-server < fix/router-server.patch && patch -p1 -R -d node_modules/expo-router < fix/expo-router.patch",
    "timing": "node timing.mjs"
  },
  "private": true
}
